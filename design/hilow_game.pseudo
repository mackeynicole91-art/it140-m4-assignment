# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode
#
# Complete the TODO prompts below with your own pseudocode.
# Keep this file in .pseudo format for submission.
#
# Use clear indentation to show decisions and repeated behavior.
# Your finished pseudocode should address every requirement in the
# current Module Four Assignment Guidelines and Rubric.

START hilow_game

    # Welcome the player
    DISPLAY "Welcome to the higher/lower game, Bella!"

    # Establish a valid guessing range.
    # Obtain the lower and upper bounds.
    # Repeat as needed until the bounds satisfy the requirement (lower < upper).
    DO
        DISPLAY "Enter the lower bound:"
        INPUT lower_bound
        DISPLAY "Enter the upper bound:"
        INPUT upper_bound

        IF lower_bound >= upper_bound THEN
            DISPLAY "The lower bound must be less than the upper bound."
        END IF
    WHILE lower_bound >= upper_bound

    # Establish the number the player is trying to guess.
    # Generate the required random number from the valid range.
    SET random_number = RANDOM integer between lower_bound and upper_bound (inclusive)

    # Play the game.
    # Obtain and validate a guess using the selected bounds.
    # Repeat the required game behavior until the correct guess.
    # Compare a valid guess and provide the required feedback.
    # Obtain and validate another guess when play continues.

    SET guessed_correctly = FALSE

    WHILE guessed_correctly == FALSE DO

        # Prompt for a guess and validate that it is within the bounds
        DO
            DISPLAY "Great, now guess a number between " + lower_bound + " and " + upper_bound + ":"
            INPUT guess

            IF guess < lower_bound OR guess > upper_bound THEN
                DISPLAY "Your guess must be between " + lower_bound + " and " + upper_bound + ". Try again."
            END IF
        WHILE guess < lower_bound OR guess > upper_bound

        # Decision branching based on the valid guess
        IF guess < random_number THEN
            DISPLAY "Nope, too low."
            DISPLAY "Guess another number:"
        ELSE IF guess > random_number THEN
            DISPLAY "Nope, too high."
            DISPLAY "Guess another number:"
        ELSE
            DISPLAY "You got it!"
            SET guessed_correctly = TRUE
        END IF

    END WHILE

END hilow_game

